# ── Secrets / env — ห้าม commit เด็ดขาด ──
.env
.env.*
!.env.example
**/.env
**/.env.local

# ── Node / frontend ──
node_modules/
frontend/dist/
frontend/node_modules/

# ── Vercel ──
.vercel/

# ── Python / backend ──
__pycache__/
*.pyc
.venv/
venv/
backend/.venv/

# ── Docker / runtime data ──
backend/data/
data/
pgdata/
n8n_data/
redis_data/
minio_data/
backend_data/

# ── Data dumps / logs ──
*.log
training_data/
*.jsonl
!training_data/.gitkeep

# ── Local tooling ──
*.tmp
.DS_Store
backend/uploads/

# ตั้งค่า editor ส่วนตัว — ไม่ใช่ของโปรเจกต์
.vscode/

# สคริปต์ patch/ดีบักแบบใช้ครั้งเดียว (ขึ้นต้นด้วย _) — ไม่ใช่ส่วนของระบบ
backend/scripts/_*.py
scripts/_*.py

# backup ก่อน merge ไฟล์ทีมบอท
_backup_app_*/
_n8n_secret.txt
_n8n_restore/

# ข้อมูลสำรองฐานข้อมูล (มีข้อมูลจริง — ห้ามขึ้น git)
backups/
tmp_db.sqlite
tmp_db.sqlite-*

# Generated QR sheets are tied to the database they were created from.
# Never commit local/demo QR images as production-ready device labels.
/qr_codes/

# ไฟล์ workflow ที่แทนค่าลับแล้ว (ห้ามขึ้น git)
*.ready.json
*.b64
