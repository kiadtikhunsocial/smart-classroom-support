{
  "name": "WF5 Analytics & PM (cron รายวัน 06:00)",
  "nodes": [
    {
      "parameters": {
        "rule": {"interval": [{"field": "days", "daysInterval": 1}], "triggerAtHour": 6, "triggerAtMinute": 0}
      },
      "id": "cron-analytics",
      "name": "Schedule 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "http://backend:8000/api/reports/summary",
        "authentication": "none",
        "options": {}
      },
      "id": "http-report",
      "name": "ดึง reports/summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {"jsCode": "const r = $input.first().json;\n// สรุปสำหรับ dashboard\nreturn [{ json: { total_tickets: r.total_tickets, total_devices: r.total_devices, open: r.open_total, snapshot_at: new Date().toISOString() } }];"},
      "id": "sum-report",
      "name": "สรุปผล",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Schedule 06:00": {"main": [[{"node": "ดึง reports/summary", "type": "main", "index": 0}]]},
    "ดึง reports/summary": {"main": [[{"node": "สรุปผล", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"}
}
