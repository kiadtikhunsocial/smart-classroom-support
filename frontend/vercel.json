{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://smart-classroom-backend-3tv7.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://smart-classroom-backend-3tv7.onrender.com/uploads/:path*"
    },
    { "source": "/((?!assets|uploads|logo\\.jpg|favicon).*)", "destination": "/index.html" }
  ]
}
