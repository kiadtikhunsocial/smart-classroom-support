# Smart Classroom — ตัวอย่าง env (copy ไปเป็น .env แล้วใส่ค่าจริง)
# อย่า commit ไฟล์ .env

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Required in production: generate long random values and store them only in
# the deployment secret manager.  N8N_SHARED_SECRET must match the value used
# in the imported n8n workflow headers.
JWT_SECRET=
N8N_SHARED_SECRET=

# LINE (สำหรับตอน deploy จริง + n8n push)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_TOKEN=
N8N_WEBHOOK_URL=http://n8n:5678/webhook/
