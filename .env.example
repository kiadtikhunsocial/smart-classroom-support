# Smart Classroom — ตัวอย่าง env (copy ไปเป็น .env แล้วใส่ค่าจริง)
# อย่า commit ไฟล์ .env
#
# ไฟล์นี้รวม "ทุกตัวแปรที่โค้ด/docker-compose/render.yaml อ่านจริง"
# ตัวที่ปล่อยว่างไว้ = ไม่จำเป็นสำหรับรันบนเครื่อง (dev) แต่ต้องตั้งตอน deploy

# ── ฐานข้อมูล ────────────────────────────────────────────────────────────
# dev ผ่าน docker compose: ไม่ต้องตั้ง (compose ชี้ไป service postgres ให้แล้ว)
# production: Neon connection string เช่น postgresql+psycopg2://user:pass@host/neondb
DATABASE_URL=

# ── สภาพแวดล้อม / ความปลอดภัย ───────────────────────────────────────────
# production / prod = backend จะไม่ยอมสตาร์ทถ้า JWT_SECRET ยังเป็นค่า dev
ENVIRONMENT=development

# ต้องตั้งค่าสุ่มยาวใน production และเก็บไว้ใน secret manager เท่านั้น
# N8N_SHARED_SECRET ต้องตรงกับค่าใน header ของ workflow ที่ import เข้า n8n
JWT_SECRET=
N8N_SHARED_SECRET=

# โดเมน frontend ที่อนุญาต (คั่นด้วย ,) — dev ผ่าน compose ตั้งให้แล้ว
CORS_ORIGINS=

# ── Google Gemini API key (https://aistudio.google.com/apikey) ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── LINE (สำหรับตอน deploy จริง + n8n push) ─────────────────────────────
# LINE_CHANNEL_TOKEN ต้องตั้งให้ตรงกันทั้ง backend และ n8n
LINE_CHANNEL_SECRET=
LINE_CHANNEL_TOKEN=
LINE_GROUP_ID=
N8N_WEBHOOK_URL=http://n8n:5678/webhook/

# ลิงก์ฟอร์มแจ้งซ่อมสาธารณะ (ใช้ในข้อความที่บอทส่งให้ผู้ใช้)
REPORT_FORM_URL=

# ── อีเมลแจ้งเตือน (ไม่ตั้ง = ข้ามการส่งอีเมล) ──────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# ── ที่เก็บไฟล์อัปโหลด ──────────────────────────────────────────────────
# local = เขียนลง backend/uploads (dev)
# cloud = S3 / S3-compatible เช่น Cloudflare R2 (จำเป็นบน Render free ที่ไม่มี disk ถาวร)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_BASE=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Frontend ────────────────────────────────────────────────────────────
# Vite ฝังค่านี้ "ตอน build" ไม่ใช่ตอน run
VITE_API_URL=http://localhost:8000/api

# ── บริการเสริมของ docker compose (มี default อยู่แล้ว ไม่ตั้งก็ได้) ────
DB_USER=postgres
DB_PASSWORD=postgres
PGADMIN_EMAIL=admin@school.ac.th
PGADMIN_PASSWORD=admin
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
N8N_ENCRYPTION_KEY=