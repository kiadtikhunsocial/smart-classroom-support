# Smart Classroom — ตัวอย่าง env (copy ไปเป็น .env แล้วใส่ค่าจริง)
# อย่า commit ไฟล์ .env
#
# ไฟล์นี้รวม "ทุกตัวแปรที่โค้ด/docker-compose/render.yaml อ่านจริง"
# ตัวที่ปล่อยว่างไว้ = ไม่จำเป็นสำหรับรันบนเครื่อง (dev) แต่ต้องตั้งตอน deploy

# ── ฐานข้อมูล ────────────────────────────────────────────────────────────
# dev ผ่าน docker compose: ไม่ต้องตั้ง (compose ชี้ไป service postgres ให้แล้ว)
# production: Neon connection string เช่น postgresql+psycopg2://user:pass@host/neondb
DATABASE_URL=

# ── สภาพแวดล้อม / ความปลอดภัย ───────────────────────────────────────────
# production / prod = backend จะไม่ยอมสตาร์ทถ้า JWT_SECRET ยังเป็นค่า dev
ENVIRONMENT=development

# ต้องตั้งค่าสุ่มยาวใน production และเก็บไว้ใน secret manager เท่านั้น
# N8N_SHARED_SECRET ต้องตรงกับค่าใน header ของ workflow ที่ import เข้า n8n
JWT_SECRET=
N8N_SHARED_SECRET=
UPLOAD_URL_SECRET=

# Local Docker only: creates this account if missing.  Do not enable in production.
BOOTSTRAP_LOCAL_ADMIN=true
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=local-admin-change-me

# โดเมน frontend ที่อนุญาต (คั่นด้วย ,) — dev ผ่าน compose ตั้งให้แล้ว
CORS_ORIGINS=

# ── Google Gemini API key (https://aistudio.google.com/apikey) ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# เปิด/ปิดชั้น AI ของแชทบอท (ไม่ตั้ง = 0 = ปิด, ใช้ rule FSM ล้วน)
# ต้องมี GEMINI_API_KEY ด้วย ไม่งั้นทุก path จะ fallback กลับกฎเดิมเงียบ ๆ
ENABLE_GEMINI_CLASSIFIER=0
ENABLE_GEMINI_ORCHESTRATION=0
ENABLE_GEMINI_NATURAL_REPLIES=0

# ── LINE (สำหรับตอน deploy จริง + n8n push) ─────────────────────────────
# LINE_CHANNEL_TOKEN ต้องตั้งให้ตรงกันทั้ง backend และ n8n
LINE_CHANNEL_SECRET=
LINE_CHANNEL_TOKEN=
LINE_GROUP_ID=
# บัญชี super_admin เดียวที่เปิดหน้า/ข้อมูลประเมิน LINE (ค่าเริ่มต้น iwasuperadmin)
RATINGS_VIEWER_USERNAME=iwasuperadmin
N8N_WEBHOOK_URL=http://n8n:5678/webhook/
# ลิงก์สมัครลูกค้าที่ chatbot ส่งให้ (local ใช้ localhost:5173)
CUSTOMER_SIGNUP_URL=http://localhost:5173/?customer=1

# ── Google Sheet สำรองข้อมูลสมาชิก/ลูกค้า/ยอดขาย ───────────────────
# แชร์ชีตให้ service account เป็น Editor และสร้างแท็บ Members, Leads, Sales
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Members!A1
GOOGLE_SHEET_LEAD_RANGE=Leads!A1
GOOGLE_SHEET_SALES_RANGE=Sales!A1
GOOGLE_SERVICE_ACCOUNT_FILE=
# Production สามารถใช้ GOOGLE_SERVICE_ACCOUNT_JSON แทน FILE ได้ (ห้าม commit ค่า)

# ลิงก์ฟอร์มแจ้งซ่อมสาธารณะ (ใช้ในข้อความที่บอทส่งให้ผู้ใช้)
REPORT_FORM_URL=

# ── อีเมลแจ้งเตือน (ไม่ตั้ง = ข้ามการส่งอีเมล) ──────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# ── ที่เก็บไฟล์อัปโหลด ──────────────────────────────────────────────────
# local = เขียนลง backend/uploads (dev)
# cloud = S3 / S3-compatible เช่น Cloudflare R2 (จำเป็นบน Render free ที่ไม่มี disk ถาวร)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
# Leave blank: uploads are always private and served through the backend.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Frontend ────────────────────────────────────────────────────────────
# Vite ฝังค่านี้ "ตอน build" ไม่ใช่ตอน run
# frontend: ตอน dev ไม่ต้องตั้งค่านี้ (vite proxy ส่ง /api ไป localhost:8000 ให้แล้ว)
# ตอน deploy ให้ตั้งที่ environment variables ของแพลตฟอร์มเป็น URL จริงของ backend
# ห้ามใส่ localhost ใน frontend/.env เพราะจะถูกฝังลง production build
# VITE_API_URL=https://<backend>.onrender.com/api

# ── บริการเสริมของ docker compose (มี default อยู่แล้ว ไม่ตั้งก็ได้) ────
DB_USER=postgres
DB_PASSWORD=postgres
PGADMIN_EMAIL=admin@school.ac.th
PGADMIN_PASSWORD=admin
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
N8N_ENCRYPTION_KEY=
